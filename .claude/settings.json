{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/claude_bootstrap.py\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/claude_gate.py\"",
                        "timeout": 10,
                        "onFailure": "block"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/claude_telemetry.py\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/claude_stop.py\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}